---
import { SITE, NAV } from '../config';
import ThemeToggle from './ThemeToggle.astro';
import SocialLinks from './SocialLinks.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => {
  // 对 anchor link 不做 active 高亮
  if (href.includes('#')) return false;
  return href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
};
---

<header
  class="sticky top-0 z-50 border-b border-line bg-canvas/85 backdrop-blur supports-[backdrop-filter]:bg-canvas/75"
>
  <div class="mx-auto flex h-16 max-w-content items-center justify-between px-4 sm:px-6">
    <!-- Logo：小 IP + 站名（像素字体） -->
    <a href="/" class="flex items-center gap-2.5" aria-label={`${SITE.name} 首页`}>
      <img
        src="/ip-logo.png"
        alt=""
        width="36"
        height="36"
        class="pixelated h-9 w-9 select-none"
      />
      <span class="font-pixel text-xl text-foreground">{SITE.name}</span>
    </a>

    <!-- 主导航 -->
    <nav class="hidden items-center gap-7 md:flex" aria-label="主导航">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class={`font-pixel text-lg transition-colors duration-150 hover:text-brand ${
              isActive(item.href) ? 'text-brand' : 'text-foreground'
            }`}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- 右侧：社交 + 主题切换 + 移动端菜单 -->
    <div class="flex items-center gap-2">
      <div class="hidden sm:block"><SocialLinks /></div>
      <ThemeToggle />
      <button
        id="menu-btn"
        class="inline-flex h-9 w-9 items-center justify-center rounded-sm text-foreground transition-colors duration-150 hover:bg-subtle md:hidden"
        type="button"
        aria-label="打开菜单"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-5 w-5"
        >
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- 移动端抽屉 -->
  <div id="mobile-menu" class="hidden border-t border-line bg-canvas md:hidden">
    <nav class="flex flex-col px-4 py-3" aria-label="移动端导航">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class={`py-2.5 font-pixel text-lg transition-colors duration-150 hover:text-brand ${
              isActive(item.href) ? 'text-brand' : 'text-foreground'
            }`}
          >
            {item.label}
          </a>
        ))
      }
      <div class="mt-3 border-t border-line pt-4">
        <SocialLinks />
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const isHidden = menu?.classList.toggle('hidden');
    const open = !isHidden;
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单');
  });
  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      menu.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
    })
  );
</script>
