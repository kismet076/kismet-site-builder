---
import { SOCIAL, type SocialPlatform } from '../config';

/**
 * Lucide 图标内联 SVG（禁止 emoji）。
 * 中文平台映射：抖音→Music2、小红书→BookOpen、微信→MessageCircle、视频号→MonitorPlay
 */
const ICONS: Record<SocialPlatform, string> = {
  douyin: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>`,
  xiaohongshu: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/></svg>`,
  wechat: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>`,
  shipinhao: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m10 7 5 3-5 3Z"/><rect width="20" height="14" x="2" y="3" rx="2"/></svg>`,
};

interface Props {
  /** 尺寸：sm=16px, md=20px（默认） */
  size?: 'sm' | 'md';
}
const { size = 'md' } = Astro.props;
const px = size === 'sm' ? 16 : 20;
const gap = size === 'sm' ? 'gap-2.5' : 'gap-3';
---

<div class:list={['flex items-center', gap]}>
  {
    SOCIAL.map((s) => (
      <a
        href={s.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={s.label}
        title={s.label}
        class="inline-flex h-9 w-9 items-center justify-center text-body transition-colors duration-150 hover:bg-brand-soft hover:text-brand"
        set:html={ICONS[s.platform].replace(
          /<svg /,
          `<svg width="${px}" height="${px}" `
        )}
      />
    ))
  }
</div>
