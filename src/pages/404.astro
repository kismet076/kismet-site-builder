---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到">
  <div class="mx-auto max-w-content px-4 py-32 text-center sm:px-6">
    <p class="font-display text-7xl font-semibold text-brand">404</p>
    <h1 class="mt-4 font-display text-3xl font-semibold text-foreground">这个页面走丢了</h1>
    <p class="mt-4 text-body">你访问的页面不存在，或者已经被移动。</p>
    <a
      href="/"
      class="mt-8 inline-flex items-center gap-2 rounded-md bg-brand px-5 py-2.5 text-sm font-medium text-white transition-colors duration-200 hover:bg-brand-hover"
    >
      返回首页
    </a>
  </div>
</BaseLayout>
