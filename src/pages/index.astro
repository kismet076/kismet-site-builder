---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { SITE } from '../config';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const popularPosts = posts.slice(0, 6);
---

<BaseLayout>
  <!-- ===== Hero ===== -->
  <section
    class="relative isolate overflow-hidden border-b-2 border-ink bg-canvas"
  >
    <!-- 像素装饰：左下角散落方块 -->
    <div
      class="pointer-events-none absolute left-0 top-1/2 hidden h-40 w-40 -translate-y-1/2 lg:block"
      aria-hidden="true"
    >
      <div class="absolute left-4 top-0 h-5 w-5 bg-accent"></div>
      <div class="absolute left-12 top-8 h-3 w-3 bg-ink"></div>
      <div class="absolute left-2 top-16 h-4 w-4 bg-ink"></div>
      <div class="absolute left-16 top-24 h-2 w-2 bg-accent"></div>
      <div class="absolute left-10 top-32 h-3 w-3 bg-ink"></div>
      <div class="absolute left-24 top-12 h-6 w-6 bg-ink"></div>
      <div class="absolute left-6 top-28 h-2 w-2 bg-accent"></div>
    </div>
    <!-- 像素装饰：右侧 IP 旁 -->
    <div
      class="pointer-events-none absolute right-12 top-12 hidden h-32 w-32 lg:block"
      aria-hidden="true"
    >
      <div class="absolute right-0 top-0 h-4 w-4 bg-accent"></div>
      <div class="absolute right-8 top-6 h-3 w-3 bg-ink"></div>
      <div class="absolute right-2 top-16 h-2 w-2 bg-ink"></div>
      <div class="absolute right-12 top-20 h-5 w-5 bg-accent"></div>
      <div class="absolute right-6 top-28 h-3 w-3 bg-ink"></div>
    </div>
    <!-- 像素装饰：底部右角（"热门文章" 区域下） -->
    <div
      class="pointer-events-none absolute -bottom-4 right-1/3 hidden h-24 w-48 lg:block"
      aria-hidden="true"
    >
      <div class="absolute right-0 top-0 h-4 w-4 bg-ink"></div>
      <div class="absolute right-8 top-4 h-2 w-2 bg-accent"></div>
      <div class="absolute right-20 top-8 h-3 w-3 bg-ink"></div>
      <div class="absolute right-32 top-2 h-2 w-2 bg-accent"></div>
    </div>

    <div
      class="relative mx-auto grid max-w-content items-center gap-10 px-4 py-16 sm:px-6 sm:py-20 lg:grid-cols-[1.05fr_0.95fr] lg:gap-8 lg:py-24"
    >
      <!-- 左：文字 -->
      <div class="relative z-10">
        <p
          class="font-pixel text-sm uppercase tracking-wider text-faint"
        >
          {SITE.author} · 个人独立站
        </p>

        <h1
          class="mt-6 font-display text-[clamp(40px,8vw,72px)] leading-[1.1] text-foreground"
        >
          {SITE.name}
        </h1>

        <p
          class="mt-5 text-[clamp(18px,2.2vw,24px)] leading-snug text-foreground sm:mt-6"
        >
          把认知变成行动，<br class="hidden sm:block" />
          把行动变成你。
        </p>

        <p class="mt-6 max-w-md text-base leading-relaxed text-body">
          {SITE.bio}
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href="/blog" class="pixel-btn">订阅</a>
          <a
            href="/about"
            class="font-pixel text-base text-foreground transition-colors duration-150 hover:text-brand"
          >
            认识我 →
          </a>
        </div>
      </div>

      <!-- 右：IP 形象（透明背景，融入白色区） -->
      <div class="relative z-10 flex items-center justify-center lg:justify-end">
        <img
          src="/ip-ghost.png"
          alt="无限进步 IP 形象"
          width="512"
          height="512"
          class="pixelated h-auto w-[280px] sm:w-[360px] lg:w-[420px]"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <!-- ===== 热门文章 ===== -->
  <section
    id="popular"
    class="relative mx-auto max-w-content px-4 py-16 sm:px-6 sm:py-20"
  >
    <div class="mb-10 flex items-baseline justify-between">
      <h2 class="font-display text-2xl text-foreground sm:text-3xl">
        热门文章
      </h2>
      <a
        href="/blog"
        class="font-pixel text-sm text-faint transition-colors duration-150 hover:text-brand"
      >
        全部文章 →
      </a>
    </div>

    {
      popularPosts.length === 0 ? (
        <p class="rounded-sm border-2 border-dashed border-line p-12 text-center text-body">
          暂无文章，敬请期待。
        </p>
      ) : (
        <div class="grid gap-7 sm:grid-cols-2 lg:grid-cols-3">
          {popularPosts.map((p) => (
            <PostCard post={p} />
          ))}
        </div>
      )
    }
  </section>

  <!-- ===== 核心理念 ===== -->
  <section
    class="border-y-2 border-ink bg-subtle"
  >
    <div class="mx-auto max-w-content px-4 py-16 sm:px-6 sm:py-20">
      <p class="font-pixel text-sm uppercase tracking-wider text-faint">
        核心理念
      </p>
      <p
        class="mt-5 max-w-3xl font-display text-2xl leading-snug text-foreground sm:text-[32px]"
      >
        「{SITE.corePhilosophy}」
      </p>
      <p class="mt-5 max-w-2xl text-body">
        这里记录认知、能力与创造的长期实验——寻找更清醒、更自主、更有生命力的活法。
      </p>
    </div>
  </section>

  <!-- ===== 订阅（一致 CTA） ===== -->
  <section class="mx-auto max-w-content px-4 py-16 sm:px-6 sm:py-20">
    <div class="border-2 border-ink bg-surface p-8 sm:p-10">
      <p class="font-pixel text-sm uppercase tracking-wider text-faint">
        保持同行
      </p>
      <h2
        class="mt-3 max-w-xl font-display text-[clamp(26px,4vw,38px)] leading-tight text-foreground"
      >
        每周一次，与更好的自己相遇。
      </h2>
      <p class="mt-4 max-w-xl text-body">
        订阅邮件通讯，第一时间收到新文章与长期实验的笔记。
      </p>
      <form
        class="mt-7 flex max-w-md flex-col gap-3 sm:flex-row sm:items-end"
        action="/contact"
        method="get"
      >
        <label class="flex-1">
          <span class="mb-1.5 block font-pixel text-sm text-faint">邮箱</span>
          <input
            type="email"
            name="email"
            placeholder="你的邮箱地址"
            class="w-full border-2 border-ink bg-canvas px-3 py-2.5 text-foreground outline-none transition-colors duration-150 placeholder:text-faint focus:bg-brand-soft"
          />
        </label>
        <button type="submit" class="pixel-btn pixel-btn--accent">
          订阅
        </button>
      </form>
    </div>
  </section>
</BaseLayout>
